---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Start a study or request a sample report from RadiusAds.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / Contact</div>
      <span class="eyebrow">Get started</span>
      <h1>Let's scope your study</h1>
      <p class="lead">Tell us a little about what you need to know. We will come back within one business day with next steps or a sample report.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="form-wrap">
        <iframe data-tally-src="https://tally.so/embed/rDBWNv?alignLeft=1&transparentBackground=1&dynamicHeight=1" loading="lazy" width="100%" height="896" frameborder="0" marginheight="0" marginwidth="0" title="Start a Study"></iframe>
        <script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>
      </div>
      <aside class="side">
        <div class="card">
          <h3>What happens next</h3>
          <ol>
            <li>We review your goals and audience</li>
            <li>A short call to confirm scope</li>
            <li>A proposal with timing and pricing</li>
          </ol>
        </div>
        <div class="card">
          <h3>Agencies</h3>
          <p>Ask about co-pitch and white-label options.</p>
          <a href="/agencies">Agency options</a>
        </div>
        <div class="card">
          <h3>Email</h3>
          <p><a href="mailto:brian@mearep.com">brian@mearep.com</a></p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
  .form-wrap { width: 100%; min-width: 0; }
  .form-wrap iframe { display: block; width: 100%; border: 0; }
  .side { display: grid; gap: 18px; }
  .side ol { padding-left: 1.2em; margin: 0; }
  .side li { margin-bottom: 6px; }
</style>
