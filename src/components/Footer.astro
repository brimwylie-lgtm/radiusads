---
import Logo from './Logo.astro';
import { products } from '../data/products.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div class="about">
        <Logo inverse />
        <p>Location-verified brand research and measurement for Canadian brands and agencies.</p>
        <a class="mr-badge" href="https://www.mearep.com" target="_blank" rel="noopener">
          <span class="dot"></span>
          <span><small>Powered by</small><strong>Measured Reporting</strong></span>
        </a>
      </div>
      <div>
        <h4>Studies</h4>
        {products.map((p) => <a href={`/products/${p.slug}`}>{p.name}</a>)}
      </div>
      <div>
        <h4>Company</h4>
        <a href="/agencies">For Agencies</a>
        <a href="/how-it-works">How It Works</a>
        <a href="/case-study">Case Study</a>
        <a href="/example">Example Study</a>
        <a href="/contact">Contact</a>
      </div>
      <div>
        <h4>Trust</h4>
        <a href="/privacy">Privacy &amp; Compliance</a>
        <p class="small">Aggregated, anonymized and privacy-compliant. PIPEDA and Quebec Law 25 aligned. Canadian data.</p>
      </div>
    </div>
    <div class="base">
      <span>&copy; {year} RadiusAds. A Measured Reporting company.</span>
      <span>We do not buy or sell media.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: rgba(255,255,255,.72); padding: 72px 0 32px; font-size: .95rem; }
  .cols { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: 40px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
  .about p { margin: 16px 0 22px; max-width: 320px; }
  h4 { color: #fff; font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 16px; }
  .cols a:not(.mr-badge) { display: block; color: rgba(255,255,255,.72); text-decoration: none; margin-bottom: 10px; }
  .cols a:not(.mr-badge):hover { color: #fff; }
  .small { font-size: .86rem; margin-top: 8px; }
  .mr-badge { display: inline-flex; align-items: center; gap: 12px; padding: 10px 16px 10px 12px; border: 1px solid rgba(255,255,255,.2); border-radius: 10px; text-decoration: none; color: #fff; transition: border-color .15s; }
  .mr-badge:hover { border-color: rgba(255,255,255,.5); }
  .mr-badge .dot { width: 26px; height: 26px; border-radius: 50%; background: radial-gradient(circle, var(--orange) 0 30%, transparent 32%), radial-gradient(circle, transparent 0 55%, var(--green) 57% 70%, transparent 72%); border: 2px solid rgba(255,255,255,.25); }
  .mr-badge small { display: block; font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.6); line-height: 1.2; }
  .mr-badge strong { display: block; font-family: var(--font-display); font-size: .98rem; line-height: 1.3; }
  .base { margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.12); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: .85rem; color: rgba(255,255,255,.55); }
</style>
